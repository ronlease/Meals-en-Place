{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)",
      "Bash(dotnet --version:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet test:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx ng:*)",
      "Bash(npx prettier:*)",
      "Skill(commit-commands:commit-push-pr:*)",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/coverage/**)",
      "Read(**/coverage-*/**)",
      "Read(**/package-lock.json)",
      "Read(**/Migrations/*.Designer.cs)",
      "Read(docs/c4/*.png)",
      "Read(**/recipes_data.csv)"
    ]
  },
  "extraKnownMarketplaces": {
    "i-feel-fine": {
      "source": { "source": "github", "repo": "ronlease/I-Feel-Fine" }
    }
  },
  "enabledPlugins": {
    "core@i-feel-fine": true,
    "dotnet-angular@i-feel-fine": true
  }
}
