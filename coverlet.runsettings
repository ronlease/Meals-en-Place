<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- The 90% gate measures the shipped API only. MealsEnPlace.Tools.Ingest
               and MealsEnPlace.Tools.Dedup are offline console utilities that are
               never deployed, and holding them to the API's bar would either
               weaken that bar or block dependency work on unrelated test debt.
               They are still built and tested in CI, just not gated. Raising
               Tools.Ingest coverage is tracked as MEP-040. -->
          <Include>[MealsEnPlace.Api]*</Include>
          <Exclude>[*]*.Migrations.*,[MealsEnPlace.Api]Program</Exclude>
          <ExcludeByFile>**/Migrations/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
